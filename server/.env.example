# Server Port
PORT=4000

# Web Client Origin for Socket.io CORS
CLIENT_ORIGIN=http://localhost:3000

# Stellar Network & Soroban Configuration
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Arbiter Signing Key (Testnet secret key: 56 chars starting with 'S')
# Leave blank to run in transient simulation/local mock mode
ARBITER_SECRET_KEY=

# Soroban Escrow Contract ID (Deployed on testnet: 56 chars starting with 'C')
ESCROW_CONTRACT_ID=
